{
  "name": "vidalo",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @vidalo/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "worker": "pnpm --filter @vidalo/worker start",
    "scan": "pnpm --filter @vidalo/core scan",
    "e2e:mock": "VIDALO_MOCK=1 tsx scripts/e2e-mock.mts",
    "verify:pg": "bash scripts/verify-pg.sh",
    "site": "node scripts/site/snapshot.mjs http://localhost:3000 out/site",
    "stripe:setup": "pnpm --filter @vidalo/web stripe:setup",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@vidalo/core": "workspace:*",
    "@vidalo/worker": "workspace:*",
    "@types/node": "^22.10.1"
  }
}
