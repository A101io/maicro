{
  "name": "maicro",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @maicro/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "worker": "pnpm --filter @maicro/worker start",
    "scan": "pnpm --filter @maicro/core scan",
    "e2e:mock": "MAICRO_MOCK=1 tsx scripts/e2e-mock.mts",
    "verify:pg": "bash scripts/verify-pg.sh",
    "site": "node scripts/site/snapshot.mjs http://localhost:3000 out/site"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@maicro/core": "workspace:*",
    "@maicro/worker": "workspace:*",
    "@types/node": "^22.10.1"
  }
}
