# --- Database (Supabase) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Engines (leave empty to run in MOCK mode) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
SERPAPI_KEY=            # Google AI Overviews / AI Mode via SERP provider
MAICRO_MOCK=1           # 1 = synthetic engine answers, no API calls

# --- Extraction model (cheap, used for claim extraction) ---
EXTRACTION_MODEL=gpt-4.1-mini

# --- Business resolution ---
GOOGLE_PLACES_API_KEY=
KVK_API_KEY=

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SETUP=      # one-off €149
STRIPE_PRICE_MONITOR=    # €49 / month

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM="Maicro <controle@maicro.nl>"

# --- Publisher ---
PUBLIC_BASE_URL=http://localhost:3000
FACTS_HOST_SUFFIX=maicro.nl          # fallback host: {slug}.feiten.maicro.nl
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
INDEXNOW_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Worker ---
FACTS_PORT=8787                      # facts pages served from the worker in dev
FACTS_CNAME_TARGET=                  # default feiten.{FACTS_HOST_SUFFIX}
WORKER_POLL_MS=2000
CRON_EVERY_MS=600000
MAICRO_OUT_DIR=out                   # mock mail (.eml), pages, operator queue
# WORKER_ONCE=1 WORKER_SEED=1        # dev: seed a demo business, drain the queue, exit
